DISCORD_TOKEN=
# Các biến dưới đây là tùy chọn (trên botkeep.cloud chỉ cần cấu hình DISCORD_TOKEN là chạy được):
CLIENT_ID=
GUILD_ID=
AUTO_REGISTER=true
PORT=3000
# Tùy chọn: nếu thêm phụ tá ngoài chủ bot mặc định, điền danh sách ID cách nhau bằng dấu phẩy.
OWNER_IDS=
# Tùy chọn Website "Now Playing" bên ngoài (Cloudflare Worker miễn phí khi botkeep.cloud không mở cổng web công khai):
NOW_PLAYING_PUSH_URL=
NOW_PLAYING_PUSH_SECRET=
# Tùy chọn đám mây Convertio API (bỏ trống mặc định để chạy Engine Local Turbo siêu nhẹ miễn phí không giới hạn):
CONVERTIO_API_KEY=
# Giới hạn vùng nhớ heap của Node (tùy chọn); lưu ý giá trị này KHÔNG giới hạn tổng RAM hay tiến trình con FFmpeg.
NODE_OPTIONS=--max-old-space-size=192
